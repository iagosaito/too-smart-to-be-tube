# Dependencies (recreated with `npm install`)
node_modules/

# Build: dist/content.js is generated by `npm run build` from src/
dist/

# Packaged extension for publishing (.zip for the Chrome Web Store, Chrome's .crx/.pem)
*.zip
*.crx
*.pem

# Test/coverage reports
coverage/

# Logs
*.log
npm-debug.log*

# Environment variables and secrets
.env
.env.*

# Subscription exports: they hold personal data and are not part of the code
inscricoes-youtube-*.csv
youtube-subscriptions-*.csv

# Operating system and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local Claude Code settings (personal permissions)
.claude/settings.local.json

# Screenshots from the real-YouTube checks (npm run e2e:youtube)
tests/e2e/youtube/output/
