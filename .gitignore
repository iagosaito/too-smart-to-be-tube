*.zip
*.crx
*.pem

# Relatórios de teste/cobertura
coverage/

# Logs
*.log
npm-debug.log*

# Variáveis de ambiente e segredos
.env
.env.*

# Exportações de inscrições: contêm dados pessoais e não fazem parte do código
inscricoes-youtube-*.csv

# Sistema operacional e editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
